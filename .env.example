# Contoh konfigurasi environment. Salin ke .env lalu isi nilainya.
# JANGAN commit file .env (sudah di .gitignore). JANGAN taruh nilai asli di sini.

# Koneksi Postgres (dipakai dev dan prod, provider tidak berganti-ganti).
# Contoh lokal (port 5435 = PGPORT default; proyek ini memakai 5435,
# JANGAN menunjuk ke port proyek lain): postgresql://USER:PASSWORD@localhost:5435/study_timer
DATABASE_URL=

# Kredensial Postgres DEV (Docker Compose). Wajib diisi di .env lokal,
# tanpa nilai default di repo. Password: openssl rand -hex 24.
# Harus cocok dengan user/password/database di DATABASE_URL di atas.
# Catatan: password hasil `openssl rand -hex` aman ditulis di URL (hex).
# Karakter khusus lain di password harus di-URL-encode.
# POSTGRES_PASSWORD hanya dipakai saat volume pertama kali dibuat;
# mengubahnya kemudian TIDAK mengubah password di dalam database.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Port host Postgres dev (loopback saja, lihat docker-compose.yml).
# Default 5435 agar DATABASE_URL yang ada tidak berubah.
# PGPORT=5435

# Rahasia sesi web (string acak, minimal 32 karakter).
# Generate: openssl rand -hex 32
SESSION_SECRET=

# Token bot dari @BotFather.
TELEGRAM_BOT_TOKEN=

# Secret header webhook Telegram (bebas, minimal 16 karakter).
# Generate: openssl rand -hex 24
TELEGRAM_WEBHOOK_SECRET=

# Chat ID Telegram yang boleh memakai bot, dipisah koma tanpa spasi. Contoh: 123456789
# Ambil dari @userinfobot. ID lain diabaikan diam-diam.
TELEGRAM_ALLOWED_CHAT_IDS=

# Secret untuk endpoint cron/pengingat (bebas, minimal 16 karakter, beda dari secret webhook).
# Generate: openssl rand -hex 24
CRON_SECRET=

# URL database bayangan (shadow) untuk `prisma migrate diff`, dev-only.
# Contoh lokal: postgresql://USER:PASSWORD@localhost:5435/study_timer_shadow
# SHADOW_DATABASE_URL=

# Koneksi langsung (direct, tanpa pooler) KHUSUS CLI Prisma (migrate/seed).
# Opsional: bila kosong dipakai DATABASE_URL. Hanya untuk mesin lokal;
# JANGAN isi di env Vercel. Generate/validate/format selalu diizinkan
# tanpa flag; operasi tulis ke non-lokal butuh ALLOW_REMOTE_DB=1 inline.
# DIRECT_URL=

# URL publik aplikasi (https). Opsional di dev, wajib saat registrasi webhook.
# Contoh: https://timer.contoh.id
# APP_BASE_URL=

# Mode bot: polling (lokal, `npm run bot`) atau webhook (produksi).
# Token dev dan prod WAJIB beda (dua bot di BotFather); polling dan webhook
# tidak boleh aktif bersamaan untuk satu token.
# BOT_MODE=polling

# Kunci preset lokasi default untuk waktu sholat: yogyakarta | karanganyar.
# LOCATION_DEFAULT_KEY=yogyakarta

# true hanya jika aplikasi berjalan di belakang proxy tepercaya (mis. Vercel)
# sehingga IP rate-limit boleh dibaca dari header X-Forwarded-For. Default false.
# TRUST_PROXY=false
